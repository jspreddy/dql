-- Numbered versions written with an atomic counter, from the AWS sample
-- amazon-dynamodb-design-patterns
-- examples/version-control/number-based-version/atomic-counters.
-- The sample increments Latest on the v0 row, then writes vN in a second call.
-- These inserts are the table after version 3 has landed.
-- v0 is the latest pointer. v1, v2, and v3 are the history.

DROP TABLE IF EXISTS aws_vc_atomic;

CREATE TABLE aws_vc_atomic (
  PK STRING HASH KEY,
  SK STRING RANGE KEY
);

INSERT INTO aws_vc_atomic (
  PK='Equipment#1',
  SK='Metadata',
  Name='EquipmentName',
  FactoryID='F#12345',
  LineID='L#12345'
);

INSERT INTO aws_vc_atomic (
  PK='Equipment#1',
  SK='v0',
  Time='2020-11-11T08:15:00',
  State='WARNING2',
  Latest=3
);

INSERT INTO aws_vc_atomic (
  PK='Equipment#1',
  SK='v1',
  Time='2020-11-10T09:00:00',
  State='WARNING1'
);

INSERT INTO aws_vc_atomic (
  PK='Equipment#1',
  SK='v2',
  Time='2020-11-10T10:30:00',
  State='NORMAL'
);

INSERT INTO aws_vc_atomic (
  PK='Equipment#1',
  SK='v3',
  Time='2020-11-11T08:15:00',
  State='WARNING2'
);

INSERT INTO aws_vc_atomic (
  PK='Equipment#2',
  SK='Metadata',
  Name='PackingLine',
  FactoryID='F#12345',
  LineID='L#67890'
);

INSERT INTO aws_vc_atomic (
  PK='Equipment#2',
  SK='v0',
  Time='2020-11-12T07:00:00',
  State='NORMAL',
  Latest=1
);

INSERT INTO aws_vc_atomic (
  PK='Equipment#2',
  SK='v1',
  Time='2020-11-12T07:00:00',
  State='NORMAL'
);

-- Latest state is the v0 row. The sample reads it with GetItem.
SELECT Time, State, Latest
FROM aws_vc_atomic
WHERE PK = 'Equipment#1' AND SK = 'v0';

-- History, excluding the v0 pointer. Single-digit versions sort in order.
SELECT SK, Time, State
FROM aws_vc_atomic
WHERE PK = 'Equipment#1' AND SK BETWEEN 'v1' AND 'v9'
ORDER BY SK ASC;

SELECT Time, State, Latest
FROM aws_vc_atomic
WHERE PK = 'Equipment#2' AND SK = 'v0';
