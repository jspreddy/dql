-- Device state log from the AWS sample
-- amazon-dynamodb-design-patterns examples/device-state-log.
-- The rows are the final NoSQL Workbench model in json/DeviceStateLog.json.
-- The sample names the sort key State#Date. DQL identifiers cannot contain #,
-- so this table calls it state_date. The value is still STATE#timestamp,
-- which keeps one device's warnings together and newest-last.
-- GSI1 is an operator's log by date.
-- GSI2 is sparse: only an escalated row sets EscalatedTo.

DROP TABLE IF EXISTS aws_device_log;

CREATE TABLE aws_device_log (
  DeviceID STRING HASH KEY,
  state_date STRING RANGE KEY
) GLOBAL INDEX ('GSI1', Operator STRING, Date STRING)
  GLOBAL INDEX ('GSI2', EscalatedTo STRING, state_date STRING);

INSERT INTO aws_device_log (
  DeviceID='d#12345',
  state_date='WARNING1#2020-04-24T14:40:00',
  Operator='Liz',
  Date='2020-04-24T14:40:00',
  State='WARNING1'
);

INSERT INTO aws_device_log (
  DeviceID='d#12345',
  state_date='WARNING1#2020-04-24T14:45:00',
  Operator='Liz',
  Date='2020-04-24T14:45:00',
  State='WARNING1'
);

