INSERT INTO aws_device_log (
  DeviceID='d#11223',
  state_date='WARNING4#2020-04-27T16:10:00',
  Operator='Sue',
  Date='2020-04-27T16:10:00',
  State='WARNING4'
);

INSERT INTO aws_device_log (
  DeviceID='d#11223',
  state_date='WARNING4#2020-04-27T16:15:00',
  Operator='Sue',
  Date='2020-04-27T16:15:00',
  State='WARNING4',
  EscalatedTo='Sara'
);

-- Newest log lines for device d#12345.
SELECT state_date, State, Operator, Date
FROM aws_device_log
WHERE DeviceID = 'd#12345'
ORDER BY state_date DESC;

-- WARNING1 lines for that device, newest first.
SELECT state_date, Operator, Date
FROM aws_device_log
WHERE DeviceID = 'd#12345' AND begins_with(state_date, 'WARNING1#')
ORDER BY state_date DESC;

-- Liz's log on 24 April 2020.
SELECT DeviceID, State, Date
FROM aws_device_log
WHERE Operator = 'Liz'
  AND Date BETWEEN '2020-04-24T00:00:00' AND '2020-04-24T23:59:59'
USING GSI1
ORDER BY Date ASC;

-- Anything escalated to Sara.
SELECT DeviceID, state_date, State, Operator
FROM aws_device_log
WHERE EscalatedTo = 'Sara'
USING GSI2;

-- Sara's WARNING4 lines from 27 April 2020.
SELECT DeviceID, state_date, Operator, Date
FROM aws_device_log
WHERE EscalatedTo = 'Sara' AND begins_with(state_date, 'WARNING4#2020-04-27')
USING GSI2;
