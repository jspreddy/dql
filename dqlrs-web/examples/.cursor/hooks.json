{
  "version": 1,
  "hooks": {
    "beforeShellExecution": [
      {
        "command": "bash .cursor/hooks/deny-shell.sh",
        "failClosed": true
      }
    ],
    "beforeReadFile": [
      {
        "command": "bash .cursor/hooks/deny-cache-read.sh",
        "failClosed": true
      }
    ],
    "preToolUse": [
      {
        "command": "bash .cursor/hooks/deny-cache-read.sh",
        "matcher": "Grep|Glob|Read|Write|Delete|Edit|StrReplace|EditNotebook",
        "failClosed": true
      }
    ]
  }
}
