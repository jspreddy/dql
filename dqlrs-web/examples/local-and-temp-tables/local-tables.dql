-- Local tables read a CSV or JSON file. Temp tables keep a query result in memory.
--
-- The first column of the file is the hash key. Types are inferred from the values.
-- A local table is read again on every query, so an edit to the file shows up
-- on the next scan. Its definition is saved encrypted and loaded the next time
-- this program starts. DROP LOCALTABLE forgets that definition and leaves the
-- file on disk. INSERT, UPDATE, and DELETE are rejected.
--
-- A temp table is the rows from a SELECT or SCAN. Every tab on this server sees
-- it. Another dqlrs process does not. It is not saved, and it is gone when this
-- process exits. INSERT into a temp table adds rows in memory only.
--
-- A name cannot belong to a DynamoDB table and a local or temp table at once.
--
-- The file path is resolved from the directory where dqlrs was started, the
-- same rule as SAVE. just web starts in the repository root.

DROP LOCALTABLE IF EXISTS sample_local_users;
DROP LOCALTABLE IF EXISTS sample_local_cities;
DROP TEMPTABLE IF EXISTS sample_temp_london;
DROP TEMPTABLE IF EXISTS sample_temp_notes;
DROP TABLE IF EXISTS sample_local_source;

-- Register the CSV that ships with these examples.
CREATE LOCALTABLE sample_local_users AS './data/sample-users.csv';
-- When the process was started in dqlrs-web/examples, use this path instead:
-- CREATE LOCALTABLE sample_local_users AS 'data/sample-users.csv';

SELECT * FROM sample_local_users WHERE id = 'a';

SCAN * FROM sample_local_users;

-- JSON is the same kind of table. id is first, so it is the hash key.
CREATE LOCALTABLE sample_local_cities AS './data/sample-cities.json';

SELECT city, country FROM sample_local_cities WHERE id = 'b';

-- Running this reports: local table 'sample_local_users' is read from its file.
-- Add a row by editing sample-users.csv, then scan again.
-- INSERT INTO sample_local_users (id, name, city) VALUES ('c', 'Lin', 'Oslo');

-- Keep the London rows in memory. This snapshot does not follow later file edits.
CREATE TEMPTABLE sample_temp_london AS (
  SCAN * FROM sample_local_users WHERE city = 'London'
);

SCAN * FROM sample_temp_london;
scan * from sample_local_users;
-- This row is visible to every tab of this server, and to no other process.
INSERT INTO sample_temp_london (id, name, city) VALUES ('c', 'Lin', 'Oslo');

SELECT * FROM sample_temp_london WHERE id = 'c';

-- The same statement can slice a DynamoDB table after the rows are inserted.
CREATE TABLE sample_local_source (
  id STRING HASH KEY
);

INSERT INTO sample_local_source (id, name) VALUES ('a', 'Ada'), ('b', 'Grace');

CREATE TEMPTABLE sample_temp_notes AS (
  SELECT * FROM sample_local_source WHERE id = 'a'
);

SCAN * FROM sample_temp_notes;

DESCRIBE sample_local_users;

DESCRIBE sample_temp_london;

-- The CSV stays on disk. The temp table does not.
-- DROP LOCALTABLE sample_local_users;
-- DROP TEMPTABLE sample_temp_london;
-- DROP TEMPTABLE sample_temp_notes;
-- DROP LOCALTABLE sample_local_cities;
-- DROP TABLE sample_local_source;
