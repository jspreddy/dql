-- load the cosmos table; pk is the parent and sk is the child
CREATE TABLE IF NOT EXISTS sample_cosmos (
  pk STRING HASH KEY,
  sk STRING RANGE KEY
) GLOBAL INDEX ('by-kind', kind STRING, name STRING);

-- three galaxies, three shapes
INSERT INTO sample_cosmos (
  pk='UNIVERSE',
  sk='GALAXY#milky-way',
  kind='galaxy',
  name='Milky Way',
  morphology='barred-spiral',
  star-count=100000000000,
  diameter_ly=105700,
  age_gyr=13.6,
  arms=('Perseus', 'Scutum-Centaurus', 'Norma', 'Sagittarius'),
  center={'object': 'Sgr A*', 'ra_h': 17.76, 'dec_deg': -29.0}
);

INSERT INTO sample_cosmos (
  pk='UNIVERSE',
  sk='GALAXY#andromeda',
  kind='galaxy',
  name='Andromeda',
  morphology='spiral',
  catalog='M31',
  distance_ly=2500000,
  approaching=TRUE,
  apparent-magnitude=3.44
);

INSERT INTO sample_cosmos (
