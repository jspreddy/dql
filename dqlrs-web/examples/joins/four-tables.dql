-- Follow one library hold from the request to the person who picked it up.
--
-- Each ON clause names one new table and one column already in the rows.
-- next_stop collides, so the later value is stored as shelves.next_stop
-- or desks.next_stop. The next JOIN reads that qualified name.

DROP TABLE IF EXISTS library_requests;
DROP TABLE IF EXISTS library_shelves;
DROP TABLE IF EXISTS library_desks;
DROP TABLE IF EXISTS library_patrons;

CREATE TABLE library_requests (
  id STRING HASH KEY,
  next_stop STRING
);

CREATE TABLE library_shelves (
  id STRING HASH KEY,
  next_stop STRING
);

CREATE TABLE library_desks (
  id STRING HASH KEY,
  next_stop STRING
);

CREATE TABLE library_patrons (
  id STRING HASH KEY,
  title STRING
);

INSERT INTO library_requests (id, next_stop) VALUES ('req-8821', 'shelf-fiction');

INSERT INTO library_shelves (id, next_stop) VALUES ('shelf-fiction', 'desk-main');

INSERT INTO library_desks (id, next_stop) VALUES ('desk-main', 'ada-okonkwo');

INSERT INTO library_patrons (id, title) VALUES ('ada-okonkwo', 'The Left Hand of Darkness');

WITH requests AS (SCAN * FROM library_requests),
     shelves AS (SCAN * FROM library_shelves),
     desks AS (SCAN * FROM library_desks),
     patrons AS (SCAN * FROM library_patrons)
SELECT * FROM requests
JOIN shelves ON requests.next_stop = shelves.id
JOIN desks ON shelves.next_stop = desks.id
JOIN patrons ON desks.next_stop = patrons.id;
