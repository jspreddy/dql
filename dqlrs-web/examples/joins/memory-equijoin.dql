-- A Saturday at the corner bakery. Load the orders and the customer
-- accounts once, then match each order to the person who placed it.
--
-- A WITH name holds its rows in memory for that statement only and is not a
-- temp table. Both sides are scanned once. The join does not look up the
-- account once per order.
-- A column on both sides keeps the left value. A different right value is
-- stored as righttable.column.
-- WHERE and LIMIT filter the orders before the merge.

DROP TABLE IF EXISTS bakery_orders;
DROP TABLE IF EXISTS bakery_customers;
DROP TEMPTABLE IF EXISTS bakery_order_rows;
DROP TEMPTABLE IF EXISTS bakery_accounts;

CREATE TABLE bakery_orders (
  id STRING HASH KEY,
  customer STRING,
  item STRING
);

CREATE TABLE bakery_customers (
  id STRING HASH KEY,
  name STRING
);

INSERT INTO bakery_orders (id, customer, item)
VALUES
  ('ord-1042', 'ada-okonkwo', 'sourdough loaf'),
  ('ord-1043', 'ada-okonkwo', 'cinnamon rolls'),
  ('ord-1044', 'walk-in', 'drip coffee');

INSERT INTO bakery_customers (id, name)
VALUES
  ('ada-okonkwo', 'Ada Okonkwo'),
  ('kenji-sato', 'Kenji Sato');

-- Two rows. The walk-in coffee has no account. Both matches are Ada Okonkwo.
-- id stays from the orders. The account id is stored as accounts.id.
WITH orders AS (SCAN * FROM bakery_orders),
     accounts AS (SCAN * FROM bakery_customers)
SELECT * FROM orders
JOIN accounts ON orders.customer = accounts.id;

-- The column list and WHERE apply to the orders, then the merge.
-- ord-1043 is the cinnamon rolls, so the name is Ada Okonkwo.
WITH orders AS (SCAN * FROM bakery_orders),
     accounts AS (SCAN * FROM bakery_customers)
SELECT name FROM orders
JOIN accounts ON accounts.id = orders.customer
WHERE id = 'ord-1043';

-- Keep both sides, then join them. Unqualified names are the order column, then the account.
CREATE TEMPTABLE bakery_order_rows AS (SCAN * FROM bakery_orders);

CREATE TEMPTABLE bakery_accounts AS (SCAN * FROM bakery_customers);

SCAN name FROM bakery_order_rows
JOIN bakery_accounts ON customer = id;

-- WITH names from the statements above are already gone.
-- SCAN * FROM orders would fail if those names had not been created again.
--
-- A DynamoDB table is refused until it is loaded:
-- SELECT * FROM bakery_orders
-- JOIN bakery_customers ON bakery_orders.customer = bakery_customers.id;
