-- 1000 clinic visits joined to 1000 reminders on the same visit number.
--
-- Each visit matches one reminder. The numbers are equal, so the column stays id.
-- reason comes from the visit and note from the reminder. Visit 15 is an eye
-- exam, and the note says to bring an insurance card.

DROP TABLE IF EXISTS clinic_visits;
DROP TABLE IF EXISTS clinic_reminders;

CREATE TABLE clinic_visits (
  id STRING HASH KEY,
  reason STRING
);

CREATE TABLE clinic_reminders (
  id STRING HASH KEY,
  note STRING
);

