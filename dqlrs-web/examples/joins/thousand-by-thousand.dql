WITH visits AS (SCAN * FROM clinic_visits),
     reminders AS (SCAN * FROM clinic_reminders)
SELECT * FROM visits
JOIN reminders ON visits.id = reminders.id;

-- Visit 15 keeps reason "eye exam" and note "bring an insurance card".
-- The matching numbers stay one column.
WITH visits AS (SCAN * FROM clinic_visits),
     reminders AS (SCAN * FROM clinic_reminders)
SELECT * FROM visits
JOIN reminders ON visits.id = reminders.id
WHERE id = '15';
