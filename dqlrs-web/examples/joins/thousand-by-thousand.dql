-- 1000 rows joined to 1000 rows on the same id.
--
-- Each left row matches one right row. The ids are equal, so the column stays id.
-- mark comes from the left and note from the right. Row 15 is L15 and R15.

DROP TABLE IF EXISTS join_thou_left;
DROP TABLE IF EXISTS join_thou_right;

CREATE TABLE join_thou_left (
  id STRING HASH KEY,
  mark STRING
);

CREATE TABLE join_thou_right (
  id STRING HASH KEY,
  note STRING
);

