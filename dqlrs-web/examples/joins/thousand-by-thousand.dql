WITH join_thou_a AS (SCAN * FROM join_thou_left),
     join_thou_b AS (SCAN * FROM join_thou_right)
SELECT * FROM join_thou_a
JOIN join_thou_b ON join_thou_a.id = join_thou_b.id;

-- Row 15 keeps mark L15 and note R15. The matching ids stay one column.
WITH join_thou_a AS (SCAN * FROM join_thou_left),
     join_thou_b AS (SCAN * FROM join_thou_right)
SELECT * FROM join_thou_a
JOIN join_thou_b ON join_thou_a.id = join_thou_b.id
WHERE id = '15';
