-- Join two saved lists into a third: the orders, the accounts, and the
-- orders that matched an account.
--
-- The two source temps stay. bakery_known_orders is the merged rows.

DROP TABLE IF EXISTS bakery_mem_orders;
DROP TABLE IF EXISTS bakery_mem_customers;
DROP TEMPTABLE IF EXISTS bakery_open_orders;
DROP TEMPTABLE IF EXISTS bakery_account_list;
DROP TEMPTABLE IF EXISTS bakery_known_orders;

CREATE TABLE bakery_mem_orders (
  id STRING HASH KEY,
  customer STRING,
  item STRING
);

CREATE TABLE bakery_mem_customers (
  id STRING HASH KEY,
  name STRING
);

INSERT INTO bakery_mem_orders (id, customer, item)
VALUES
  ('ord-1042', 'ada-okonkwo', 'sourdough loaf'),
  ('ord-1043', 'ada-okonkwo', 'cinnamon rolls'),
  ('ord-1044', 'walk-in', 'drip coffee');

INSERT INTO bakery_mem_customers (id, name)
VALUES
  ('ada-okonkwo', 'Ada Okonkwo'),
  ('kenji-sato', 'Kenji Sato');

CREATE TEMPTABLE bakery_open_orders AS (SCAN * FROM bakery_mem_orders);

CREATE TEMPTABLE bakery_account_list AS (SCAN * FROM bakery_mem_customers);

CREATE TEMPTABLE bakery_known_orders AS (
  SELECT * FROM bakery_open_orders
  JOIN bakery_account_list ON bakery_open_orders.customer = bakery_account_list.id
);

SCAN * FROM bakery_known_orders;

SCAN * FROM bakery_open_orders;

SCAN * FROM bakery_account_list;
