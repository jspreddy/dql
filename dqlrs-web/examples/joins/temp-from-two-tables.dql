-- Save the bakery orders that belong to a known account.
--
-- The WITH queries inside CREATE TEMPTABLE load each side once. The temp table
-- keeps the merged rows. The WITH names disappear when the statement finishes.

DROP TABLE IF EXISTS bakery_src_orders;
DROP TABLE IF EXISTS bakery_src_customers;
DROP TEMPTABLE IF EXISTS bakery_known_orders;

CREATE TABLE bakery_src_orders (
  id STRING HASH KEY,
  customer STRING,
  item STRING
);

CREATE TABLE bakery_src_customers (
  id STRING HASH KEY,
  name STRING
);

INSERT INTO bakery_src_orders (id, customer, item)
VALUES
  ('ord-1042', 'ada-okonkwo', 'sourdough loaf'),
  ('ord-1043', 'ada-okonkwo', 'cinnamon rolls'),
  ('ord-1044', 'walk-in', 'drip coffee');

INSERT INTO bakery_src_customers (id, name)
VALUES
  ('ada-okonkwo', 'Ada Okonkwo'),
  ('kenji-sato', 'Kenji Sato');

CREATE TEMPTABLE bakery_known_orders AS (
  WITH orders AS (SCAN * FROM bakery_src_orders),
       accounts AS (SCAN * FROM bakery_src_customers)
  SELECT * FROM orders
  JOIN accounts ON orders.customer = accounts.id
);

SCAN * FROM bakery_known_orders;

-- The copies used to build the join are gone. The saved orders remain.
