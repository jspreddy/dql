-- One guest's trips, newest arrival last because sk is the arrival date.
SELECT sk, building, arrive, depart, status, nightly_cents
FROM hp_stays
WHERE pk = 'GUEST#ada' AND begins_with(sk, 'RES#');

-- Which nights unit 2A is already taken.
SELECT sk, guest_name, res_id
FROM hp_stays
WHERE pk = 'UNIT#2a' AND begins_with(sk, 'NIGHT#');

-- Every booked reservation, in arrival order, from the status index.
SELECT sk, unit_id, arrive, depart, guests
FROM hp_stays
WHERE status = 'booked' AND begins_with(sk, 'RES#')
USING by-status;

-- What this stay costs beyond the nightly rate.
SELECT label, cents
FROM hp_stays
WHERE pk = 'RES#r-184' AND begins_with(sk, 'CHARGE#');
