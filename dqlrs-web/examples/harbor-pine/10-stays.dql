  res_id='r-184',
  unit_id='UNIT#2a',
  building='Pine Court',
  arrive='2026-07-03',
  depart='2026-07-06',
  nights=3,
  status='booked',
  guests=2,
  nightly_cents=18900,
  currency='USD'
);

