-- Charges hang off the reservation, not the guest.
INSERT INTO hp_stays (
  pk='RES#r-184',
  sk='CHARGE#cleaning',
  kind='charge',
  res_id='r-184',
  label='Cleaning',
  cents=7500,
  currency='USD'
);

