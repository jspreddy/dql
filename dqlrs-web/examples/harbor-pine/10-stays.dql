-- Harbor & Pine: guests, reservations, nights, and charges in one table.
-- A guest holds a profile and that guest's reservations.
-- A unit holds one row per occupied night, so the calendar is one query.
-- A reservation holds its charges.
-- by-unit finds a guest's reservation from the unit.
-- by-status finds booked stays in arrival order.

DROP TABLE IF EXISTS hp_stays;

CREATE TABLE hp_stays (
  pk STRING HASH KEY,
  sk STRING RANGE KEY
) GLOBAL INDEX ('by-unit', unit_id STRING, sk STRING)
  GLOBAL INDEX ('by-status', status STRING, arrive STRING);

INSERT INTO hp_stays (
  pk='GUEST#ada',
  sk='PROFILE',
  kind='guest',
  name='Ada Okonkwo',
  email='ada@example.com',
  phone='+1-206-555-0148',
  city='Seattle',
  trips=2
);

