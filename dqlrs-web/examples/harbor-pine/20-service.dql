-- Parts and notes live under the job, so one query loads the ticket.
INSERT INTO hp_service (
  pk='WO#w-9',
  sk='PART#fan-110',
  kind='part',
  wo_id='w-9',
  sku='FAN-110',
  label='Bath fan, 110 CFM',
  qty=1,
  cents=6400
);

INSERT INTO hp_service (
  pk='WO#w-9',
  sk='PART#screw-8',
  kind='part',
  wo_id='w-9',
  sku='SCR-8',
  label='Mounting screws',
  qty=4,
  cents=180
);

INSERT INTO hp_service (
  pk='WO#w-9',
  sk='NOTE#1',
  kind='note',
  wo_id='w-9',
  author='mina',
  body='Guest says it rattles after 10 minutes.',
  at='2026-06-30T18:12:00Z'
);

-- Jobs opened at Pine Court.
SELECT sk, title, assignee, status, due
FROM hp_service
WHERE pk = 'BLDG#pine' AND begins_with(sk, 'WO#');

-- The open board, earliest due date first.
SELECT sk, title, assignee, unit_name, due
FROM hp_service
WHERE status = 'open' AND begins_with(sk, 'WO#')
USING by-status;

-- Mina's queue, including the job she already closed.
SELECT sk, title, status, due, unit_name
FROM hp_service
WHERE assignee = 'mina' AND begins_with(sk, 'WO#')
USING by-assignee;

-- Everything filed on work order w-9.
SELECT sk, kind, label, body, qty, cents
FROM hp_service
WHERE pk = 'WO#w-9';
