-- Harbor & Pine: staff, work orders, parts, and notes in one table.
-- A building holds its staff and the jobs opened there.
-- A work order holds the parts used and the notes left on it.
-- by-assignee is one person's queue.
-- by-status is the open board, in due-date order.

DROP TABLE IF EXISTS hp_service;

CREATE TABLE hp_service (
  pk STRING HASH KEY,
  sk STRING RANGE KEY
) GLOBAL INDEX ('by-assignee', assignee STRING, sk STRING)
  GLOBAL INDEX ('by-status', status STRING, due STRING);

INSERT INTO hp_service (
  pk='BLDG#pine',
  sk='STAFF#mina',
  kind='staff',
  name='Mina Alvarez',
  role='lead',
  phone='+1-206-555-0190',
  on_call=TRUE
);

